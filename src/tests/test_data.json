{
    "$schema": "test_data_schema",
    "description": "測試資料分配表。groups 存 common 資料和 test-specific 資料。依賴鏈由 scan_test_file() 從 .py decorator 即時掃描，不存在此檔。",
    "rules": {
        "group_max_tests": 5,
        "exclusive_resources": {
            "spare_parts": "同一個備品只能被一個 group 使用（影響數量統計）",
            "rooms": "同一間房只能被一個 group 使用",
            "link_nos_target": "關聯單號綁定後不可重複綁定"
        },
        "room_allocation": "4F 給綜合櫃台腳本、5F-STD 給房務帳腳本，新 group 按區域選房"
    },
    "new_group_guide": {
        "room_pool": "CLI 掃綜合櫃台頁面取得全部房間，扣除 shared_resources.rooms 和各 group common.room 已佔用的 = 可用房間",
        "card_setup": "可用 Walk-In 流程自動建卡（CLI 操作綜合櫃台），或請使用者手動建立",
        "card_naming": "Card Maindesk FLow {letter}，letter 遞增（A~E 已用）",
        "card_search_by": "住客姓名",
        "checkin_date": "與環境 system_date 一致"
    },
